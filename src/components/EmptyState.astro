---
interface Props {
  title: string;
  label: string;
  headingLevel?: 2 | 3;
}
const { title, label, headingLevel = 2 } = Astro.props;
const Heading = `h${headingLevel}` as "h2" | "h3";
---
<section class="empty" aria-label={label}>
  <svg class="empty__art" viewBox="0 0 160 160" aria-hidden="true" focusable="false">
    <rect x="8" y="8" width="144" height="144" rx="6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-dasharray="6 6" />
    <rect x="28" y="28" width="104" height="104" fill="none" stroke="currentColor" stroke-width="1" opacity=".55" />
    <path d="M80 28 132 80 80 132 28 80Z" fill="none" stroke="currentColor" stroke-width="1" opacity=".55" />
    <circle cx="80" cy="80" r="22" fill="none" stroke="currentColor" stroke-width="1" opacity=".55" />
    <path d="M80 62 82.6 77.4 98 80 82.6 82.6 80 98 77.4 82.6 62 80 77.4 77.4Z" fill="#6D1723" />
  </svg>
  <div class="empty__body">
    <p class="eyebrow">Em preparação</p>
    <Heading class="empty__title">{title}</Heading>
    <slot />
  </div>
</section>
