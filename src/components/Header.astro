---
import { ButtonLink } from "@/components/ButtonLink";
import { MobileMenu } from "@/components/islands/MobileMenu";
import Seal from "@/components/Seal.astro";
import Star from "@/components/Star.astro";
import { brandName, contactEmail, contactPhone, contactPhoneLabel, instagramOficialUrl, isCurrent, nav } from "@/data/site";

const path = Astro.url.pathname;
const links = nav.filter((item) => item.href !== "/contactos/");
---
<div class="topbar">
  <div class="site-wrap topbar-inner">
    <p class="topbar-flags"><span>Portugal</span><Star /><span>Brasil</span></p>
    <p class="topbar-contact">
      <a href={`mailto:${contactEmail}`}>{contactEmail}</a>
      <span aria-hidden="true">·</span>
      <a href={`tel:${contactPhone}`}>{contactPhoneLabel}</a>
      {instagramOficialUrl && <><span aria-hidden="true">·</span><a href={instagramOficialUrl} target="_blank" rel="noopener">Instagram</a></>}
    </p>
  </div>
</div>
<header class="site-header">
  <div class="site-wrap site-bar">
    <a class="brand-link" href="/" aria-label={`${brandName}, início`}>
      <Seal size="sm" decorative />
      <span class="brand-copy">
        <span class="brand-name">{brandName}</span>
        <span class="brand-kicker">Instituto Cultural &amp; Artístico Luso-Brasileiro</span>
      </span>
    </a>
    <nav class="site-nav" aria-label="Secções">
      {links.map((item) => (
        <a href={item.href} aria-current={isCurrent(path, item.href) ? "page" : undefined}>{item.label}</a>
      ))}
    </nav>
    <div class="site-tools">
      <span class="site-cta"><ButtonLink href="/contactos/" current={isCurrent(path, "/contactos/")}>Contactos</ButtonLink></span>
      <span class="site-menu">
        <MobileMenu client:load items={[...nav]} currentPath={path} instagramUrl={instagramOficialUrl} />
      </span>
    </div>
  </div>
</header>
