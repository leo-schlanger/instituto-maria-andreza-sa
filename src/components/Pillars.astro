---
import SafetyNote from "@/components/SafetyNote.astro";
import { pillars, pillarsIntro } from "@/data/site";

interface Props {
  headingId: string;
  tone?: "light" | "dark";
  title?: string;
}

const { headingId, tone = "light", title = "Três pilares" } = Astro.props;
const icons: Record<string, string> = {
  // Scales of justice
  justice: '<path d="M12 3v18M7 21h10M4 7h16M12 4.5 4 7l-2.5 6a3.5 3.5 0 0 0 5 0L4 7M20 7l-2.5 6a3.5 3.5 0 0 0 5 0L20 7" />',
  // Woman with rising star
  woman: '<circle cx="12" cy="8" r="4" /><path d="M4.5 21a7.5 7.5 0 0 1 15 0" /><path d="M19 2.5l.6 1.4 1.4.6-1.4.6-.6 1.4-.6-1.4-1.4-.6 1.4-.6Z" />',
  // Hands holding a heart
  hands: '<path d="M12 11.5s-3.5-2.1-3.5-4.4A2 2 0 0 1 12 6a2 2 0 0 1 3.5 1.1c0 2.3-3.5 4.4-3.5 4.4Z" /><path d="M2.5 14.5 6 13l4 2.5h3.5a1.5 1.5 0 0 1 0 3H9M13.5 18.5l5-2.3a1.6 1.6 0 0 1 2 2.4L15 22H6.5L2.5 20" />',
};
---
<section class:list={["pillars section-pad", `pillars--${tone}`]} aria-labelledby={headingId}>
  <div class="pillars__pattern" aria-hidden="true"></div>
  <div class="site-wrap">
    <div class="section-head reveal">
      <p class:list={["eyebrow", tone === "dark" && "eyebrow--light"]}>Missão</p>
      <h2 id={headingId} class="section-title">{title}</h2>
      <p class="section-intro">{pillarsIntro}</p>
    </div>
    <div class="pillars__grid">
      {pillars.map((p, i) => (
        <article class="pillar reveal">
          <div class="pillar__top">
            <span class="pillar__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" set:html={icons[p.icon]} />
            </span>
            <span class="pillar__n" aria-hidden="true">{["I", "II", "III"][i]}</span>
          </div>
          <h3 class="pillar__title">{p.title}</h3>
          {"subtitle" in p && <p class="pillar__sub">{p.subtitle}</p>}
          <p class="pillar__text">{p.text}</p>
          {"safety" in p && <SafetyNote />}
        </article>
      ))}
    </div>
  </div>
</section>
