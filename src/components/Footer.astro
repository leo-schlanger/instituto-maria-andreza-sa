---
import Star from "@/components/Star.astro";
import { brandName, contactEmail, contactPhone, contactPhoneLabel, instagramOficialUrl, nav, orgName, registeredName } from "@/data/site";
---
<footer class="site-footer">
  <div class="footer-pattern" aria-hidden="true"></div>
  <div class="site-wrap footer-grid">
    <div class="footer-brand">
      <span class="footer-medal" aria-hidden="true"><Star /></span>
      <div>
        <p class="footer-name">{brandName}</p>
        <p class="footer-org">{orgName}</p>
      </div>
    </div>
    <nav class="footer-col" aria-label="Secções do site">
      <p class="footer-title">Navegação</p>
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <div class="footer-col">
      <p class="footer-title">Contacto</p>
      <a class="footer-contact" href={`mailto:${contactEmail}`}>{contactEmail}</a>
      <a class="footer-contact" href={`tel:${contactPhone}`}>{contactPhoneLabel}</a>
      <a href="/contactos/">Página de contactos</a>
      {instagramOficialUrl && (
        <a class="footer-social" href={instagramOficialUrl} target="_blank" rel="noopener">Instagram</a>
      )}
    </div>
    <nav class="footer-col" aria-label="Informação legal">
      <p class="footer-title">Informação</p>
      <a href="/privacidade/">Privacidade</a>
      <a href="/termos/">Termos</a>
      <a href="/cookies/">Cookies</a>
    </nav>
  </div>
  <div class="site-wrap footer-base">
    <p class="footer-registered"><Star />{registeredName}</p>
    <p class="credit">Desenvolvido por <a href="https://leoschlanger.com" target="_blank" rel="noopener">leoschlanger.com</a></p>
  </div>
</footer>
