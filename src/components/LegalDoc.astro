---
import { readFileSync } from "node:fs";
import path from "node:path";
import { renderLegalMarkdown } from "@/lib/legal-md.mjs";

interface Props {
  file: string;
}

const full = path.join(process.cwd(), Astro.props.file);
const html = renderLegalMarkdown(readFileSync(full, "utf8"));
---
<div class="legal" set:html={html} />
