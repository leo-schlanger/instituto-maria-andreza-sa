---
import type { VideoPronto } from "@/lib/video";

interface Props {
  video: VideoPronto;
  headingId: string;
  titulo?: string;
}

const { video, headingId, titulo = "Vídeo" } = Astro.props;
// Self-hosted file only: no third-party player, no cookies (media-src falls back to default-src 'self').
---
<section class="event-video" aria-labelledby={headingId} data-video>
  <h2 id={headingId} class="sources__title">{titulo}</h2>
  <video
    controls
    preload="none"
    playsinline
    poster={video.poster}
    width="1920"
    height="1080"
    aria-describedby={`${headingId}-desc`}
  >
    <source src={video.ficheiro} type="video/mp4" />
    <a href={video.ficheiro}>Descarregar o vídeo</a>
  </video>
  <p id={`${headingId}-desc`} class="event-video__desc">{video.descricao}</p>
</section>
