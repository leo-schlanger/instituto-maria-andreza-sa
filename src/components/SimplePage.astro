---
import Base from "@/layouts/Base.astro";

interface Props {
  title: string;
  description: string;
  path: string;
  h1: string;
  paragraphs: readonly string[];
}

const { title, description, path, h1, paragraphs } = Astro.props;
const [lead, ...rest] = paragraphs;
---
<Base title={title} description={description} path={path}>
  <div class="site-wrap page-pad reading">
    <h1>{h1}</h1>
    {lead && <p class="lede">{lead}</p>}
    {rest.length > 0 && (
      <div class="reading-body">
        {rest.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    )}
  </div>
</Base>
