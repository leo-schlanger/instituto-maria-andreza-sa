---
import Arrow from "@/components/Arrow.astro";
import { ButtonLink } from "@/components/ButtonLink";
import Divider from "@/components/Divider.astro";
import EventVideo from "@/components/EventVideo.astro";
import Gallery from "@/components/Gallery.astro";
import OrnamentPanel from "@/components/OrnamentPanel.astro";
import PageHero from "@/components/PageHero.astro";
import Photo from "@/components/Photo.astro";
import Star from "@/components/Star.astro";
import { fotosPorEvento } from "@/data/eventos-fotos";
import { eventInstagramLabel } from "@/data/evento-ui";
import { eventos, type Evento } from "@/data/eventos";
import Base from "@/layouts/Base.astro";
import { eventNode, videoNode } from "@/lib/seo";
import { videoDoEvento } from "@/lib/video";
import { siteUrl } from "@/data/site";

export function getStaticPaths() {
  return eventos.map((evento) => ({ params: { slug: evento.slug }, props: { evento } }));
}

const { evento } = Astro.props as { evento: Evento };
const path = `/projetos/${evento.slug}/`;
const ficha = [
  evento.data && { term: "Data", value: evento.data },
  evento.local && { term: "Local", value: evento.local },
].filter(Boolean) as { term: string; value: string }[];
const narrativa = evento.narrativa ?? [];
const fotos = fotosPorEvento[evento.slug] ?? [];
const evNode = eventNode(evento, siteUrl + path, fotos);
const capa = fotos[0];
const video = videoDoEvento(evento);
const celebracao = evento.celebracao;
const nodes = [evNode, video && videoNode(video, siteUrl + path)].filter(Boolean) as Record<string, unknown>[];
---
<Base
  title={`${evento.titulo} | Maria Andreza Sá`}
  description={evento.resumo}
  path={path}
  ogType="article"
  crumbs={[{ name: "Projetos", path: "/projetos/" }, { name: evento.titulo, path }]}
  structuredData={nodes}
>
  <PageHero h1={evento.titulo} crumb={evento.titulo} eyebrow="Evento" lede={evento.resumo} parent={{ href: "/projetos/", label: "Projetos" }}>
    {capa && (
      <figure slot="media" class="page-hero__photo">
        <Photo foto={capa} sizes="(min-width: 900px) 420px, 90vw" eager />
      </figure>
    )}
  </PageHero>
  <div class="site-wrap page-body">
    <div class="reading reveal">
      {narrativa.length > 0 && (
        <section class="story" aria-labelledby="narrativa-titulo">
          <p class="eyebrow">Pelo Instituto</p>
          <h2 id="narrativa-titulo" class="story__title">{evento.narrativaTitulo ?? evento.titulo}</h2>
          {narrativa.slice(0, -1).map((p, i) => <p class:list={[i === 0 && "dropcap"]}>{p}</p>)}
          {narrativa.length > 1 && (
            <div class="story__quote"><Star /><p>{narrativa.at(-1)}</p></div>
          )}
        </section>
      )}
      {video && <EventVideo video={video} headingId="video-titulo" titulo="Vídeo da festa" />}
      {narrativa.length > 0 ? (
        <section class="press" aria-labelledby="imprensa-titulo">
          <p class="eyebrow">Factos com fonte</p>
          <h2 id="imprensa-titulo" class="story__title">O que a imprensa registou</h2>
          {evento.corpo.map((p) => <p>{p}</p>)}
        </section>
      ) : (
        evento.corpo.map((p, i) => <p class:list={[i === 0 && evento.corpo.length > 2 && "dropcap"]}>{p}</p>)
      )}
      {celebracao && (
        <section class="celebration" aria-labelledby="celebracao-titulo">
          <p class="eyebrow">Segundo o missal</p>
          <h2 id="celebracao-titulo" class="story__title">{celebracao.titulo}</h2>
          {celebracao.paragrafos.map((p) => <p>{p}</p>)}
          {celebracao.citacao && (
            <div class="story__quote"><Star /><p>«{celebracao.citacao}»</p></div>
          )}
          <h3 class="celebration__sub">Programa da celebração</h3>
          <ol class="celebration__list">
            {celebracao.programa.map((item) => (
              <li><strong>{item.parte}.</strong> {item.itens.split(/(\d+, \d+(?:-\d+)?)/).map((t, i) => (i % 2 ? <span class="celebration__ref">{t}</span> : t))}</li>
            ))}
          </ol>
          <p class="celebration__source">Fonte: {celebracao.fonte}</p>
        </section>
      )}
      <Gallery fotos={fotos} titulo={evento.titulo} />
      <Divider />
      {evento.fontes.length > 0 && (
        <section class="sources" aria-labelledby="fontes-titulo">
          <h2 id="fontes-titulo" class="sources__title">Fontes</h2>
          <ol>
            {evento.fontes.map((f) => (
              <li><a href={f.url} target="_blank" rel="noopener">{f.titulo}</a></li>
            ))}
          </ol>
        </section>
      )}
    </div>
    <aside class="page-aside" aria-label="Sobre o evento">
      {fotos.length === 0 && <OrnamentPanel kicker={evento.local} title={evento.data} class="event-poster reveal" />}
      {ficha.length > 0 && (
        <div class="fact-card reveal">
          <p class="fact-card__title">Ficha</p>
          <dl>{ficha.map((f) => <div><dt>{f.term}</dt><dd>{f.value}</dd></div>)}</dl>
        </div>
      )}
      {evento.instagramUrl && (
        <div class="status-note reveal">
          <p class="related__title">Acompanhar</p>
          <ButtonLink href={evento.instagramUrl} variant="secondary" external>{eventInstagramLabel(evento)}</ButtonLink>
        </div>
      )}
      <nav class="related reveal" aria-label="Outras secções">
        <p class="related__title">Continuar a ler</p>
        <a href="/projetos/">Projetos e eventos<Arrow /></a>
        <a href="/cultura/">Cultura<Arrow /></a>
        <a href="/portugal-e-brasil/">Portugal e Brasil<Arrow /></a>
      </nav>
    </aside>
  </div>
</Base>
