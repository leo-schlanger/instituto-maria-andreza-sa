---
import LegalDoc from "@/components/LegalDoc.astro";
import { pages } from "@/data/site";
import Base from "@/layouts/Base.astro";

const page = pages.termos;
---
<Base title={page.title} description={page.description} path={page.path}>
  <div class="site-wrap page-pad">
    <LegalDoc file={page.file} />
  </div>
</Base>
