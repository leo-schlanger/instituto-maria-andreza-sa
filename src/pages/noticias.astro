---
import { ButtonLink } from "@/components/ButtonLink";
import EmptyState from "@/components/EmptyState.astro";
import PageHero from "@/components/PageHero.astro";
import { eventos } from "@/data/eventos";
import { pages } from "@/data/site";
import Base from "@/layouts/Base.astro";

const page = pages.noticias;
const latest = eventos[0];
---
<Base title={page.title} description={page.description} path={page.path} pageType="CollectionPage" crumbs={[{ name: "Notícias", path: page.path }]}>
  <PageHero h1={page.h1} crumb="Notícias" eyebrow="Arquivo" lede={page.paragraphs[0]} />
  <div class="site-wrap section-pad">
    <EmptyState title="Ainda sem notícias" label="Sem notícias publicadas">
      <p>Cada notícia entra aqui com a data real da atividade.</p>
      <div class="action-row">
        {latest ? (
          <ButtonLink href={`/projetos/${latest.slug}/`}>{latest.titulo}</ButtonLink>
        ) : (
          <ButtonLink href="/projetos/">Projetos</ButtonLink>
        )}
        <ButtonLink href="/contactos/" variant="outline">Contactos</ButtonLink>
      </div>
    </EmptyState>
  </div>
</Base>
