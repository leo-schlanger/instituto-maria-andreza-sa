---
import { ButtonLink } from "@/components/ButtonLink";
import Seal from "@/components/Seal.astro";
import Base from "@/layouts/Base.astro";
---
<Base title="Página não encontrada" description="Este endereço não está neste site." path="/404/" noindex>
  <section class="notfound">
    <div class="notfound__pattern" aria-hidden="true"></div>
    <div class="site-wrap notfound__inner">
      <div class="notfound__mark" aria-hidden="true">
        <span>4</span><Seal size="md" decorative /><span>4</span>
      </div>
      <h1>Página não encontrada</h1>
      <p class="lede">Este endereço não está neste site.</p>
      <div class="action-row action-row--center">
        <ButtonLink href="/">Início</ButtonLink>
        <ButtonLink href="/associacao/" variant="outline">A associação</ButtonLink>
        <ButtonLink href="/contactos/" variant="outline">Contactos</ButtonLink>
      </div>
    </div>
  </section>
</Base>
