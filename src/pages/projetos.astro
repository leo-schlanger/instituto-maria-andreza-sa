---
import { ButtonLink } from "@/components/ButtonLink";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { instagramUrl, pages } from "@/data/site";
import Base from "@/layouts/Base.astro";

const page = pages.projetos;
---
<Base title={page.title} description={page.description} path={page.path}>
  <div class="site-wrap page-pad empty-layout">
    <div>
      <h1>{page.h1}</h1>
      <p class="lede">{page.paragraphs[0]}</p>
    </div>
    <section aria-label="Sem lista de eventos">
      <Card>
        <CardHeader>
          <CardTitle>Ainda sem lista</CardTitle>
        </CardHeader>
        <CardContent>
          <p>{page.paragraphs[1]}</p>
          <div class="action-row">
            <ButtonLink href={instagramUrl} variant="secondary" external>Instagram</ButtonLink>
            <ButtonLink href="/contactos/" variant="outline">Contactos</ButtonLink>
          </div>
        </CardContent>
      </Card>
    </section>
  </div>
</Base>
