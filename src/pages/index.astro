---
import Arrow from "@/components/Arrow.astro";
import { ButtonLink } from "@/components/ButtonLink";
import EventCard from "@/components/EventCard.astro";
import Founder from "@/components/Founder.astro";
import Pillars from "@/components/Pillars.astro";
import Seal from "@/components/Seal.astro";
import Star from "@/components/Star.astro";
import { eventos } from "@/data/eventos";
import { facts, pages } from "@/data/site";
import Base from "@/layouts/Base.astro";

const page = pages.home;
const areas = [
  { href: "/associacao/", label: "A associação", text: pages.associacao.description },
  { href: "/cultura/", label: "Cultura", text: pages.cultura.description },
  { href: "/portugal-e-brasil/", label: "Portugal e Brasil", text: pages.portugal.description },
  { href: "/projetos/", label: "Projetos", text: pages.projetos.description },
  { href: "/noticias/", label: "Notícias", text: pages.noticias.description, soon: true },
];
const featured = eventos[0];
---
<Base title={page.title} description={page.description} path={page.path}>
  <section class="hero">
    <div class="hero__pattern" aria-hidden="true"></div>
    <div class="hero__glow" aria-hidden="true"></div>
    <div class="site-wrap hero__grid">
      <div class="hero__copy">
        <p class="eyebrow eyebrow--light enter" style="--d:0"><Star />Instituto Cultural e Artístico Luso-Brasileiro</p>
        <h1 class="hero__title enter" style="--d:1">
          <span>Associação cultural</span>
          <span><em>e</em> artística</span>
          <span class="hero__accent">luso-brasileira</span>
        </h1>
        <p class="hero__lede enter" style="--d:2">{page.paragraphs[0]}</p>
        <div class="action-row enter" style="--d:3">
          <ButtonLink href="/associacao/" variant="ivory" size="lg">Conhecer a associação</ButtonLink>
          <ButtonLink href="#pilares-titulo" variant="outlineLight" size="lg">Os três pilares</ButtonLink>
        </div>
      </div>
      <div class="hero__seal enter" style="--d:2">
        <span class="hero__orbit" aria-hidden="true"></span>
        <Seal size="xl" priority />
      </div>
    </div>
    <div class="hero__edge" aria-hidden="true"></div>
  </section>

  <section class="facts" aria-label="Ficha do instituto">
    <div class="site-wrap">
      <dl class="facts__card">
        {facts.map((f) => <div><dt>{f.term}</dt><dd>{f.value}</dd></div>)}
      </dl>
    </div>
  </section>

  <Pillars headingId="pilares-titulo" />

  <Founder headingId="fundadora-titulo" />

  {featured && (
    <section class="featured section-pad" aria-labelledby="destaque-titulo">
      <div class="site-wrap">
        <div class="section-head reveal">
          <p class="eyebrow">Em destaque</p>
          <h2 id="destaque-titulo" class="section-title">Eventos</h2>
          <p class="section-intro">{page.paragraphs[3]}</p>
        </div>
        <div class="reveal">
          <EventCard evento={featured} />
        </div>
        <p class="note"><Star />{page.paragraphs[4]}</p>
      </div>
    </section>
  )}

  <section class="bridge" aria-labelledby="ponte-titulo">
    <div class="site-wrap bridge__grid">
      <div class="bridge__art reveal" aria-hidden="true">
        <span class="bridge__label bridge__label--pt">Portugal</span>
        <span class="bridge__medal"><Star /></span>
        <span class="bridge__label bridge__label--br">Brasil</span>
      </div>
      <div class="bridge__copy reveal">
        <p class="eyebrow eyebrow--light">Duas margens, uma língua</p>
        <h2 id="ponte-titulo" class="section-title">Portugal e Brasil</h2>
        <p>{pages.portugal.paragraphs[0]}</p>
        <ButtonLink href="/portugal-e-brasil/" variant="ivory">Ler sobre Portugal e Brasil</ButtonLink>
      </div>
    </div>
  </section>

  <section class="areas section-pad" aria-labelledby="areas-titulo">
    <div class="site-wrap">
      <div class="section-head reveal">
        <p class="eyebrow">Explorar</p>
        <h2 id="areas-titulo" class="section-title">O site do instituto</h2>
      </div>
      <div class="areas__grid">
        {areas.map((a, i) => (
          <a class="area reveal" href={a.href}>
            <span class="area__n" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
            <span class="area__title">{a.label}</span>
            <span class="area__text">{a.text}</span>
            <span class="area__foot">
              {a.soon ? <span class="pill">Em preparação</span> : <span class="pill pill--quiet">Abrir</span>}
              <Arrow />
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="closing" aria-labelledby="contacto-titulo">
    <div class="site-wrap">
      <div class="closing__card reveal">
        <div class="closing__pattern" aria-hidden="true"></div>
        <span class="closing__medal" aria-hidden="true"><Star /></span>
        <div class="closing__copy">
          <h2 id="contacto-titulo">Falar com o instituto</h2>
          <p>{pages.contactos.description}</p>
        </div>
        <ButtonLink href="/contactos/" variant="ivory" size="lg">Contactos</ButtonLink>
      </div>
    </div>
  </section>
</Base>
